{
    "target": "esp32s3",
    "builds": [
        {
            "name": "esp32wroom32-esp32s3-custom-st7789-sd",
            "sdkconfig_append": [
                "CONFIG_BOARD_TYPE_ESP32WROOM32=y",
                "CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y",
                "CONFIG_PARTITION_TABLE_CUSTOM_FILENAME=\"partitions/v2/8m.csv\"",
                "CONFIG_WAKE_WORD_DISABLED=y"
            ]
        }
    ]
}
